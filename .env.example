# Template of the keys a `.env` file must carry — NOT a place to keep values.
#
# Secrets live in Bitwarden and are rendered into `.env.local` by:
#
#     pnpm secrets          # write .env.local from the "Tabi — Local Dev" note
#     pnpm secrets:check    # verify .env.local matches the vault
#
# Never hand-edit `.env.local`: the next run overwrites it from the vault.

# ── Supabase ──────────────────────────────────────────────────────────────
# One project per environment:
#   Local (`supabase start`)        → http://127.0.0.1:54321
#   Sandbox (Vercel Preview)        → https://rjsrzuqyoyxuonvcrpec.supabase.co
#   Production (Vercel Production)  → https://yfwslmehyaftomzmkafs.supabase.co
#
# Vercel Preview and Production carry their own scoped copies of these; only
# local development reads them from `.env.local`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Provider keys (optional, `.env.agent` for the agent harness) ──────────
# `scripts/agent/lib/env.mjs` maps these to BYOK rows for its test user.
# The app itself reads them from the `api_keys` table, not from the environment.

# GOOGLE_PLACES_API_KEY=
# GEOAPIFY_API_KEY=
# OVERPASS_ENDPOINT=
# OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=
