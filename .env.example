# ── Supabase — one project per environment ────────────────────────────────
# Sandbox (Vercel Preview):      https://rjsrzuqyoyxuonvcrpec.supabase.co
# Production (Vercel Production): https://yfwslmehyaftomzmkafs.supabase.co
# Dev local uses Supabase Local (`supabase start`) → http://127.0.0.1:54321
#
# These placeholders are for LOCAL DEV (Supabase Local). Vercel Preview and
# Production each have their own scoped env vars pointing at their project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Optional: API keys as fallback (env vars override user keys)
# GOOGLE_PLACES_API_KEY=
# GEOAPIFY_API_KEY=
# OVERPASS_ENDPOINT=
# OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=
